{
    "name": "ernestdefoe/longshot",
    "description": "Longshot \u2014 a virtual-points sportsbook for Flarum. Moneylines, spreads, totals and props on real games or your own events; singles and parlays; a member-vs-member exchange; settlement straight from the Picks data feed; weekly allowances, per-group limits and leaderboards. Points only: no real money, ever.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "sportsbook",
        "betting",
        "virtual currency",
        "sports",
        "gamification",
        "leaderboard"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/longshot",
    "support": {
        "issues": "https://github.com/ernestdefoe/longshot/issues",
        "source": "https://github.com/ernestdefoe/longshot"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Longshot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\Longshot\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Longshot",
            "category": "feature",
            "icon": {
                "name": "fas fa-ticket",
                "backgroundColor": "#0f766e",
                "color": "#fff"
            },
            "optional-dependencies": [
                "ernestdefoe/picks",
                "fof/gamification"
            ]
        }
    },
    "require-dev": {
        "ernestdefoe/picks": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0",
        "fof/gamification": "^2.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse",
        "test:unit": "phpunit -c tests/phpunit.unit.xml"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis",
        "test:unit": "Runs the unit tests (odds, grading, feed parsing)."
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
