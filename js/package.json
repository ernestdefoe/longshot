{
  "private": true,
  "name": "@ernestdefoe/longshot",
  "version": "0.1.0",
  "devDependencies": {
    "@flarum/prettier-config": "^1.0.0",
    "flarum-tsconfig": "^2.0.0",
    "flarum-webpack-config": "^3.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.0.0",
    "typescript-coverage-report": "^2.1.2",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0",
    "less": "^4.2.0"
  },
  "scripts": {
    "dev": "node tools/css.mjs && webpack --mode development --watch",
    "build": "node tools/css.mjs && webpack --mode production",
    "check-typings": "node tools/css.mjs && tsc --noEmit --project tsconfig.json",
    "format": "prettier --write src",
    "format-check": "prettier --check src",
    "check-typings-coverage": "typescript-coverage-report"
  },
  "prettier": "@flarum/prettier-config"
}
